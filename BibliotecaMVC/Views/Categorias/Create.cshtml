@model BibliotecaMVC.Models.Categoria
@{ ViewData["Title"] = "Agregar categoría"; }
<h1>Agregar categoría</h1>
<form asp-action="Create" method="post">
    <div class="mb-3"><label asp-for="Nombre"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Descripcion"></label><textarea asp-for="Descripcion" class="form-control" rows="3"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
    <button type="submit" class="btn btn-success">Guardar</button><a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
