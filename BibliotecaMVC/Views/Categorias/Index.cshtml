@model IEnumerable<BibliotecaMVC.Models.Categoria>
@{ ViewData["Title"] = "Categorías"; }

<div class="d-flex align-items-center mb-3">
    <h1>Gestión de categorías</h1>
    <a asp-action="Create" class="btn btn-primary ms-auto">Agregar categoría</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Id</th><th>Nombre</th><th>Descripción</th><th>Acciones</th></tr></thead>
    <tbody>
    @foreach (var categoria in Model)
    {
        <tr>
            <td>@categoria.Id</td><td>@categoria.Nombre</td><td>@categoria.Descripcion</td>
            <td>
                <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
