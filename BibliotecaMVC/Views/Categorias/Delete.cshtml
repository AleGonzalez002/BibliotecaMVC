@model BibliotecaMVC.Models.Categoria
@{ ViewData["Title"] = "Eliminar categoría"; }
<h1>Eliminar categoría</h1>
<p>¿Está seguro que desea eliminar la categoría <strong>@Model.Nombre</strong>?</p>
<dl class="row"><dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@Model.Descripcion</dd></dl>
<form asp-action="DeleteConfirmed" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Eliminar</button><a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
