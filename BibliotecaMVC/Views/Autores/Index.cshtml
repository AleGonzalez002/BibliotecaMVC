@using BibliotecaMVC.Models
@model IEnumerable<Autor>

<div class="d-flex align-items-center mb-3">
	<h1>Catálogo de autores</h1>
	<a asp-action="Create" class="btn btn-primary ms-auto">Agregar autor</a>
</div>
<table class="table table-striped">
	<thead>
		<tr>
			<th>Id</th>
			<th>Nombre</th>
			<th>Apellido</th>
			<th>Nacionalidad</th>
			<th>Fecha de Nacimiento</th>
			<th>Edad</th>
			<th>Estado</th>
			<th>Acciones</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var autor in Model)
		{
			<tr>
				<td>@autor.Id</td>
				<td>@autor.Nombre</td>
				<td>@autor.Apellido</td>
				<td>@autor.Nacionalidad</td>
				<td>@autor.FechaNacimiento.ToShortDateString()</td>
				<td>@(DateTime.Now.Year - autor.FechaNacimiento.Year)</td>
				<td>
					@if (autor.Activo)
					{
						<span class="badge bg-success">Sí</span>
					}
					else
					{
						<span class="badge bg-danger">No</span>
					}
				</td>
				<td>
					<a asp-action="Details" asp-route-id="@autor.Id" class="btn btn-sm btn-info">Detalle</a>
					<a asp-action="Edit" asp-route-id="@autor.Id" class="btn btn-sm btn-warning">Editar</a>
					<a asp-action="Delete" asp-route-id="@autor.Id" class="btn btn-sm btn-danger">Eliminar</a>
				</td>
			</tr>
		}
	</tbody>
</table>
