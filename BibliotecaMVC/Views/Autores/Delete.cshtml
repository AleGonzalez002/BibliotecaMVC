@model BibliotecaMVC.Models.Autor
@{
    ViewData["Title"] = "Eliminar Autor";
}

<h1>Eliminar autor</h1>
<p>¿Está seguro que desea eliminar a @Model.Nombre @Model.Apellido?</p>

<dl class="row">
    <dt class="col-sm-3">Nacionalidad</dt>
    <dd class="col-sm-9">@Model.Nacionalidad</dd>
    <dt class="col-sm-3">Fecha de nacimiento</dt>
    <dd class="col-sm-9">@Model.FechaNacimiento.ToString("yyyy-MM-dd")</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
