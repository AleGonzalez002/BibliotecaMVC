@model BibliotecaMVC.Models.Autor
@{
	ViewData["Tittle"] = "Detalles del Autor";
}

<h1>@Model.Nombre</h1>
<dl class="row">
	<dt>Nacionalidad</dt>
	<dd>@Model.Nacionalidad</dd>
	<dt>Fecha de Nacimiento</dt>
	<dd>@Model.FechaNacimiento.ToString("yyyy-MM-dd")</dd>
	<dt>Edad</dt>
	<dd>@(DateTime.Now.Year - Model.FechaNacimiento.Year)</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-primary">Volver atras</a>