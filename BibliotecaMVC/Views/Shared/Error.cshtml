@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="alert alert-danger mt-4" role="alert">
    <h1 class="h4">Ocurrió un problema</h1>
    <p class="mb-0">No pudimos completar tu solicitud. Inténtalo de nuevo más tarde.</p>
</div>

@if (Model.ShowRequestId)
{
    <p class="text-muted">Código de referencia: <code>@Model.RequestId</code></p>
}
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
