@{
    ViewData["Title"] = "Acerca de";
}

<header class="about-hero">
    <p class="about-eyebrow">Biblioteca Virtual</p>
    <h1>Acerca de nuestra biblioteca</h1>
    <p>Un espacio digital creado para acercar los libros, los autores y el conocimiento a cada lector.</p>
</header>

<section class="about-content" aria-label="Información de la biblioteca">
    <article class="about-story info-card">
        <h2>Nuestra misión</h2>
        <p>Facilitar el acceso a la lectura y a los recursos bibliográficos mediante una plataforma organizada, clara y disponible para toda la comunidad.</p>
        <p>Promovemos la curiosidad, el aprendizaje continuo y el hábito de leer a través de un catálogo que reúne diferentes autores y categorías.</p>
    </article>

    <aside class="about-services info-card" aria-labelledby="services-heading">
        <h2 id="services-heading">Nuestros servicios</h2>
        <ul>
            <li>Consulta de libros y autores.</li>
            <li>Organización de obras por categorías.</li>
            <li>Registro y seguimiento de préstamos.</li>
            <li>Orientación para encontrar nuevas lecturas.</li>
        </ul>
    </aside>
</section>

<section class="about-values" aria-labelledby="values-heading">
    <h2 id="values-heading">Lo que nos inspira</h2>
    <div class="about-values-grid">
        <article class="feature-card">
            <h3>Lectura</h3>
            <p>Creemos que cada libro abre una puerta a nuevas ideas.</p>
        </article>
        <article class="feature-card">
            <h3>Comunidad</h3>
            <p>Compartimos recursos para apoyar a estudiantes y lectores.</p>
        </article>
        <article class="feature-card">
            <h3>Conocimiento</h3>
            <p>Organizamos la información para que sea fácil de descubrir.</p>
        </article>
    </div>
</section>
